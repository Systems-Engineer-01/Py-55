rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Función auxiliar para verificar si el usuario es el dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Función auxiliar para verificar si el usuario tiene rol de Administrador
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.esAdmin == true;
    }

    // ── Colección de Usuarios ──────────────────────────────────────
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificado', 'esAdmin'])
      );
      allow delete: if isAdmin();
    }

    // ── Colección de Conductores / Mototaxistas ─────────────────────
    match /conductores/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estadoVerificacion', 'verificado'])
      );
      allow delete: if isAdmin();
    }

    // ── Colección de Viajes ─────────────────────────────────────────
    match /viajes/{rideId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.pasajeroId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.pasajeroId == request.auth.uid ||
        resource.data.conductorId == request.auth.uid ||
        resource.data.conductorId == null ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Subcolección de Calificaciones
      match /calificaciones/{ratingId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.quienCalifica == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ── Colección de Alertas de Pánico ─────────────────────────────
    match /alertas_panico/{alertId} {
      // Cualquier usuario autenticado puede crear una alerta solo a su propio nombre
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Lectura permitida si es el propio emisor o si es Administrador
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Solo Administradores pueden actualizar el estado a "atendida" o eliminar
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
